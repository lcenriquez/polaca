{
  "name": "@polaca/backend",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "migrate": "node-pg-migrate up -m ../database/migrations --envPath .env",
    "migrate:down": "node-pg-migrate down -m ../database/migrations --envPath .env",
    "migrate:create": "node-pg-migrate create -m ../database/migrations --migration-file-language sql",
    "seed": "tsx --env-file=.env src/scripts/seed.ts",
    "seed:dev": "tsx --env-file=.env src/scripts/seed.ts --dev",
    "db:dump": "docker compose -f ../docker-compose.yml exec -T db pg_dump -U polaca --schema-only --no-owner polaca > ../database/schema.sql"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "argon2": "^0.45.1",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.2",
    "dotenv": "^18.0.4",
    "eslint": "^10.11.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
