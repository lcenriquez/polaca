# Copia este archivo a .env — los valores funcionan con code/docker-compose.yml.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_URL=http://localhost:3000
TRUST_PROXY=false
API_DOCS=true

DATABASE_URL=postgres://polaca:polaca@localhost:5432/polaca

# 32 bytes aleatorios en hex: openssl rand -hex 32
VOTE_SECRET=cambia-esto-en-cada-entorno

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="POLACA <no-responder@polaca.test>"

# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
